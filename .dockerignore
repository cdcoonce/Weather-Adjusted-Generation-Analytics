# VCS / editor / assistant metadata — never needed in the image.
.git
.gitignore
.github
.claude
.superpowers
.vscode
.idea

# Python
.venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage*
htmlcov
*.egg-info

# Secrets — never bake these into the image; runtime secrets arrive as env
# vars from the Dagster run launcher instead. .env.example is a template
# (no real values) so it's fine to ship.
.env
.env.*
!.env.example
*.p8
*.pem
*.pub

# Dagster runtime state (regenerated per-container; nothing here persists
# between runs anyway under DockerRunLauncher).
data/
.dagster/
logs/

# dbt build output — dbt_packages/ is fetched by `dbt deps` and target/ by
# `dbt parse`, both run inside the build itself; shipping a stale host copy
# would shadow that.
dbt/renewable_dbt/target/
dbt/renewable_dbt/dbt_packages/
dbt/renewable_dbt/logs/

# Cockpit dashboard build output — regenerated by waga_dashboard_publish.
dashboard_exports/
dist/
.wrangler/
node_modules/

# Docs — README.md is kept: hatchling's `readme` field in pyproject.toml
# needs it present in the build context.
docs
*.md
!README.md
